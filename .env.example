# ICube 后端环境变量配置
# 复制本文件为 .env 并填写实际值

# ========== 必须修改 ==========

# 允许访问的主机：填你的服务器公网IP或域名，多个用逗号分隔
ALLOWED_HOSTS=your-server-ip,localhost

# 允许的前端跨域来源：填域名即可，脚本会自动加 http/https 前缀
# 没域名就填公网IP，例如 123.45.67.89
ALLOWED_ORIGIN=your-server-ip

# 支付宝回调地址（没接支付宝先随便填，后面改）
SERVER_HOST=your-server-ip

# ========== 支付宝配置（可选）==========

# 支付宝应用 ID（沙箱/正式环境各有一个）
# 沙箱默认值 9021000162660623，正式环境在支付宝开放平台获取
ALIPAY_APP_ID=9021000162660623

# 支付宝调试模式（True=沙箱环境，False=生产环境）
# 上线前必须改为 False
ALIPAY_DEBUG=True

# 支付宝回调 URL 协议（默认根据 DEBUG 自动选择：沙箱 http / 生产 https）
# 如需覆盖可手动指定，例如 https
#ALIPAY_SCHEME=https

# ========== 可选修改（安全性建议改）==========

# Django 生产环境 SECRET_KEY（改个随机长字符串，至少 32 位）
SECRET_KEY=your-random-secret-key-at-least-32-chars

# 数据库密码（和 docker-compose.yml 里的 MYSQL_PASSWORD 保持一致就行，默认不用改）
DB_PASSWORD=icube123

# ========== 邮件配置（可选）==========

EMAIL_HOST_USER=your-email@qq.com
EMAIL_HOST_PASSWORD=your-smtp-authorization-code
EMAIL_SMTP_ENABLED=False
